{
    "$schema": "https://schemas.wp.org/trunk/block.json",
    "apiVersion": 3,
    "name": "just-form/feedback-form",
    "title": "Форма обратной связи",
    "category": "widgets",
    "icon": "email-alt",
    "description": "Форма обратной связи с защитой от спама",
    "keywords": ["contact", "form", "feedback"],
    "textdomain": "just-form",
    "attributes": {
        "privacyUrl": {
            "type": "string",
            "default": ""
        },
        "buttonText": {
            "type": "string",
            "default": "Отправить"
        },
        "recipientEmail": {
            "type": "string",
            "default": ""
        }
    },
    "supports": {
        "align": ["wide", "full"],
        "color": {
            "background": true,
            "text": true
        },
        "spacing": {
            "padding": true
        }
    }
}
